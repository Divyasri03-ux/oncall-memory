# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Hindsight Vectorize Memory Settings
# Base URL (e.g., https://api.hindsight.vectorize.io or http://localhost:8888)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Hindsight API Key (from https://ui.hindsight.vectorize.io)
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Memory Bank identifier for Northwind Pay
HINDSIGHT_BANK_ID=northwind-oncall

# Optional Server Settings
PORT=8000
HOST=0.0.0.0
